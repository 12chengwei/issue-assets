[2026-07-21 11:19:45.629] [0;32mI (59836294) TASK_NL: [3] Cmd rsp(7071): {"plugins":[{"uuid":"027842e4-e1d6-4a4c-a731-be74a1ebd4cf","name":"Flow","description":"Imagine you dump each color onto your panels. Watch the color flow in a direction of your choosing.","author":"Nanoleaf","type":"color","tags":["zen"," happy"],"features":["touch"],"pluginConfig":[{"name":"loop","type":"bool","defaultValue":true},{"name":"transTime","type":"int","defaultValue":24,"minValue":1,"maxValue":600},{"name":"delayTime","type":"int","defaultValue":0,"minValue":0,"maxValue":600},{"name":"linDirection","type":"string","defaultValue":"right","strings":["left","right","up","down"]}]},{"uuid":"1dab05d3-07bf-4648-9d48-db8dd196ed28","name":"Organic","description":"Soft clusters of light appear, float, and dissolve in random yet natural feeling forms","author":"Nanoleaf","type":"color","tags":["organic","natural"],"features":["touch","dynamicPalette"],"pluginConfig":[{"name":"scale","type":"double","defaultValue":1.0,"minValue":0.01,"maxValue":5.0},{"name":"linDirection","type":"string","defaultValue":"none","strings":["left","right","up","down","none"]},{"name":"transTime","type":"double","defaultValue":24.0,"minValue":1.0,"maxValue":600.0},{"name":"evolutionSpeed","type":"double","defaultValue":1.0,"minValue":0.01,"maxValue":5.0},{"name":"stretch","type":"double","defaultValue":5.0,"minValue":0.0,"maxValue":10.0}]},{"uuid":"23e70ff4-458c-4852-826f-9315d89ee6ed","name":"Meteor Shower","description":"Like a meteor shower of music notes, watch as a stardust of colors sprinkle across the panels to the pitch of the music. Colors on the left indicate low notes while the right represents higher notes.","author":"Nanoleaf","type":"rhythm","tags":["party"," electronic"," vibrant"," pop"],"features":[]},{"uuid":"30018343-7587-4152-8d97-1c349ccc3e68","name":"Paint Splatter","description":"Like paint splatters on a wall, random circular clusters of panels will show blots of color alternating to the beat of the music. The colors are taken from your palette, and randomly selected to correspond to the varying pitches in the song.","author":"Nanoleaf","type":"rhythm","tags":["vibrant"," happy"," classical"," pop"," acoustic"],"features":[],"pluginConfig":[{"name":"transTime","type":"int","defaultValue":24,"minValue":1,"maxValue":600}]},{"uuid":"337784c0-6c98-447a-8a9f-fc6ac44a8024","name":"Streaking Notes","description":"Each color of your palette is assigned from low notes to high notes. When that note plays, you'll see that color shoot across your Aurora","author":"Nanoleaf","type":"rhythm","tags":["pop"," party"," electronic"],"features":[]},{"uuid":"5cec763a-6f32-45cf-a691-b81e176b6b4a","name":"Fireworks","description":"This could be your very own mini EDM festival. In this musical fireworks display, explosions of color from your palette are set off to the bass of the song. ","author":"Nanoleaf","type":"rhythm","tags":["happy"," electronic"," party"," vibrant"," pop"],"features":[]},{"uuid":"60333927-cc36-4a5a-a682-9bd114de8bff","name":"Pulse Pop Beats","description":"Designed for vocals and slow jams. Increased flux in the song will trigger pops of color on the panels, and a pulse of colors with fluctuation in the tone of the song. ","author":"Nanoleaf","type":"rhythm","tags":["electronic"," rap"," classical"],"features":[]},{"uuid":"6970681a-20b5-4c5e-8813-bdaebc4ee4fa","name":"Wheel","description":"Provides a continuous moving gradient of color created from your palette.","author":"Nanoleaf","type":"color","tags":["party"," chill"," zen"],"features":["touch"],"pluginConfig":[{"name":"loop","type":"bool","defaultValue":true},{"name":"transTime","type":"int","defaultValue":24,"minValue":1,"maxValue":600},{"name":"nColorsPerFrame","type":"int","defaultValue":2,"minValue":2,"maxValue":50},{"name":"linDirection","type":"string","defaultValue":"right","strings":["left","right","up","down"]}]},{"uuid":"70b7c636-6bf8-491f-89c1-f4103508d642","name":"Highlight","description":"Just like random, but you will mostly see the first color of your palette. The other colors fade in periodically.","author":"Nanoleaf","type":"color","tags":["chill"," zen"],"features":["touch","dynamicPalette"],"pluginConfig":[{"name":"transTime","type":"int","defaultValue":24,"minValue":1,"maxValue":600},{"name":"delayTime","type":"int","defaultValue":15,"minValue":0,"maxValue":600},{"name":"mainColorProb","type":"double","defaultValue":80.0,"minValue":0.0,"maxValue":100.0}]},{"uuid":"713518c1-d560-47db-8991-de780af71d1e","name":"Burst","description":"Your palette colors radiate out from the center of the panels.","author":"Nanoleaf","type":"color","tags":["chill"," zen"],"features":["touch"],"pluginConfig":[{"name":"loop","type":"bool","defaultValue":true},{"name":"transTime","type":"int","defaultValue":24,"minValue":1,"maxValue":600},{"name":"delayTime","type":"int","defaultValue":0,"minValue":0,"maxValue":600}]},{"uuid":"b3fd723a-aae8-4c99-bf2b-087159e0ef53","name":"Fade","description":"The Light Panels cycle through your palette colors all together.","author":"Nanoleaf","type":"color","tags":["chill"," zen"],"features":["touch"],"pluginConfig":[{"name":"loop","type":"bool","defaultValue":true},{"name":"transTime","type":"int","defaultValue":24,"minValue":1,"maxValue":600},{"name":"delayTime","type":"int","defaultValue":0,"minValue":0,"maxValue":600}]},{"uuid":"ba632d3e-9c2b-4413-a965-510c839b3f71","name":"Random","description":"This will take your palette colors and randomly animate them across your panels.","author":"Nanoleaf","type":"color","tags":["party"," happy"],"features":["touch"],"pluginConfig":[{"name":"transTime","type":"int","defaultValue":24,"minValue":1,"maxValue":600},{"name":"delayTime","type":"int","defaultValue":0,"minValue":0,"maxValue":600}]},{"uuid":"bc6fe7e0-36d4-4f95-aa21-52a386daa9dc","name":"Ripple","description":"Wisps of color dance across the display, creating a majestic ripple effect outwards based on the music's intensity. ","author":"Nanoleaf","type":"rhythm","tags":["chill"," pop"," vibrant"," accoustic"],"features":[]},{"uuid":"fa0ce428-ad3a-40a9-84e4-1c9316644852","name":"Classic Visualizer","description":"An ode to the old school music visualizer. Your palette colors will be assigned left to right. Depending on your layout, colors may not all show up for larger palettes.","author":"Nathan","type":"rhythm","tags":["party"," electronic"," vibrant"," pop"],"features":[]},{"uuid":"fe0d0ba8-741f-4210-940c-454eceed010f","name":"Sound Bar","description":"Two of your favorite colors compete in a dance-off to the intensity of music. The length of your setup will determine the direction the soundbar will go. Works best for softer music.","author":"Nanoleaf","type":"rhythm","tags":["ambient"," acoustic"," classical"," vocal"," chill"],"features":[]},{"uuid":"fa987895-9612-41c6-9ff4-b1d02cf5ce18","name":"LightCycle","description":"Take your Aurora out for a ride on the digital frontier where good and evil are locked in an eternal battle for cyberspace","author":"Seratonik","type":"rhythm","tags":["party","dim","warm","ambient","cool"],"features":[]}]}[0m
